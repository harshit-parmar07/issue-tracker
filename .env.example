# Prisma / Aiven MySQL Connection URL
# For Aiven MySQL, retain SSL parameters (e.g., sslaccept=strict) and append connection_limit=2 to prevent Lambda/SSR connection pool exhaustion
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict&connection_limit=2"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Sentry Telemetry & Deployment
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_AUTH_TOKEN="your_sentry_auth_token_here"
GOOGLE_CLIENT_SECRET=""